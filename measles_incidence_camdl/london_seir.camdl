# Seasonally forced stochastic SEIR (He, Ionides & King 2010 structure)
# for London measles — generated by make_city_models.py; do not hand-edit.
#
# Structure identical to camdl_replication/he2010_london.camdl (validated
# against pomp there): term-time forcing, cohort school-entry pulse,
# (I + iota)^alpha inhomogeneous mixing, Gamma noise on the FOI, and the
# He et al. discretized-Normal observation model on accumulated recoveries.

time_unit = 'days

compartments { S, E, I, R }

parameters {
  R0        : positive    in [1.0, 100.0]
  sigma     : rate        in [0.01, 0.5]
  gamma     : rate        in [0.01, 0.5]
  mu        : rate        in [1e-6, 0.01]
  alpha     : positive [1] in [0.5, 1.0]
  iota      : count       in [0.01, 100.0]
  sigma_se  : positive [1] in [0.001, 5.0]
  amplitude : probability in [0.0001, 0.9999]
  cohort    : probability in [0.0001, 0.9999]
  rho       : probability in [0.0001, 0.9999]
  psi       : positive [1] in [0.001, 1.0]
  s0        : probability in [0.001, 0.5]
  e0        : probability in [1e-6, 0.01]
  i0        : probability in [1e-6, 0.01]
  N0        : count       in [1000, 10000000]
}

forcing {
  pop : interpolated 'count {
    data      = "data/london_covariates.tsv"
    time_col  = "t"
    value_col = "pop"
    method    = linear
  }

  birthrate : interpolated 'per_year {
    data      = "data/london_covariates.tsv"
    time_col  = "t"
    value_col = "birthrate"
    method    = linear
  }

  # School-term forcing (term days 7-100, 115-199, 252-300, 308-356;
  # 277 school days / 365).  UK calendar, retained for the US cities as
  # an approximation — Dalziel et al. (2016) estimated US seasonal
  # transmission to track school terms closely.
  school : periodic 'ratio {
    period = 365.25 'days
    step   = 1 'days
    on     = [7:100, 115:199, 252:300, 308:356]
  }
}

let beta_base = R0 * (1.0 - exp(-(gamma + mu) * 1 'days))
let seas = 1.0 - amplitude + amplitude * (1.0 + 0.2411 / 0.7589) * school(t)
let daily_births = birthrate(t) * pop(t)

transitions {
  infection : S --> E  @ overdispersed(beta_base * seas * S * unchecked_dim((I + iota) ^ alpha, dim = population, reason = "He et al. alpha-mixing: phenomenological P^alpha term") / pop(t), sigma_se)
  latency   : E --> I  @ sigma * E
  recovery  : I --> R  @ gamma * I
  birth : --> S  @ deterministic((1.0 - cohort) * daily_births)
  death_S : S -->  @ mu * S
  death_E : E -->  @ mu * E
  death_I : I -->  @ mu * I
  death_R : R -->  @ mu * R
}

init {
  S = s0 * N0
  E = e0 * N0
  I = i0 * N0
  R = N0 - s0 * N0 - e0 * N0 - i0 * N0
}

events {
  cohort_entry : add(S, cohort * birthrate(t) * pop(t) * 1 'years)
    every 365.25 'days at_day 258
}

balance {
  R = pop(t) - S - E - I
}

observations {
  weekly_cases {
    columns       { time : time, weekly_cases : count }
    projected     = incidence(recovery)
    emit_schedule = every 7 'days
    weekly_cases  ~ normal(
      mean = rho * projected,
      sd   = sqrt(rho * projected * (1.0 - rho + psi * psi * rho * projected))
    )
  }
}

simulate {
  from = 0 'days
  to   = 5474 'days
}
