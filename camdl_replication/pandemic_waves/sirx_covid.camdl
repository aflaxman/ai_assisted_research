# Coupled behaviour-disease "SIRx" model of Frimpong & Bauch (2026),
# "Pandemic waves as the outcome of coupled behaviour and disease
# dynamics", medRxiv 2026.02.05.26345658 (supplement eqs. 9-12, 14-15).
#
#   dS/dt = -beta (1 + b cos(2pi (t - phi)/365)) (1 - eps x) S I
#   dI/dt = +...  - gamma I
#   dx/dt = kappa x (1 - x) ( (I/eta0) e^{-lam t} - c )
#   reported incidence = (C(t) - C(t-1)) / eta0
#
# x is the mitigator (NPI-supporting) proportion, driven by imitation
# dynamics on the payoff difference between mitigating (cost c) and not
# (perceived infection risk). The paper's supplement writes the payoff
# with prevalence I, but its code divides by the under-reporting factor
# (utility responds to *reported* prevalence I/eta0) — the code's form
# is used here.
#
# The paper works in population proportions with a deterministic ODE;
# here S, I, R are counts (N = pop) and X = pop*x is a real-valued
# compartment integrated by the same ODE backend — identical dynamics
# up to the count scale.

time_unit = 'days

compartments { S, I, R, X : real }

parameters {
  #' baseline transmission rate; paper range [0.1, 0.9]
  #' @symbol β
  beta    : rate in [0.1, 0.9]
  #' seasonal transmission amplitude; paper range [0, 1]
  b       : real [1] in [0.0, 1.0]
  #' recovery rate; paper range [0.1, 0.5] (infectious period 2-10 d)
  #' @symbol γ
  gamma   : rate in [0.1, 0.5]
  #' phase of seasonal transmission, days; paper's code range [-135, -45]
  #' @symbol φ
  phi     : real in [-135.0, -45.0]
  #' constant under-reporting factor; paper range [1, 10]
  #' @symbol η₀
  eta0    : real [1] in [1.0, 10.0]
  #' NPI efficacy; paper range [0.1, 0.8]
  #' @symbol ε
  eps     : real [1] in [0.1, 0.8]
  #' social learning rate; paper's code range [100, 5000] per day
  #' @symbol κ
  kappa   : rate in [100.0, 5000.0]
  #' sensitivity decay of perceived risk; paper's code range [0, 0.2]
  #' @symbol λ
  lam     : rate in [0.0, 0.2]
  #' cost of maintaining NPIs; paper's code range [0, 0.01]
  c       : real in [0.0, 0.01]
  #' initial infectious fraction; paper range [1/pop, 2000/pop]
  i0      : real [1] in [1e-9, 5e-4]
  #' initial mitigator fraction; country-specific range in the paper's code
  x0      : real [1] in [0.0, 0.25]
  #' observation sd for the smoothed daily case counts (replaces the
  #' paper's ABC case tolerance; normal likelihood ~ their least squares)
  sigma_i : positive [P] in [0.1, 1e6]
  #' observation sd for the stringency index, permille scale (replaces
  #' the paper's ABC behaviour tolerance)
  sigma_x : positive [1] in [1.0, 500.0]
  #' country population (fixed per fit)
  pop     : count in [1e6, 1e8]
}

transitions {
  infection : S --> I
    @ beta * (1.0 + b * cos(2.0 * pi * (t * (1.0 'per_day) - phi) / 365.0))
      * (1.0 - eps * X / pop) * S * I / pop
  recovery  : I --> R @ gamma * I
}

init {
  S = pop * (1.0 - i0)
  I = pop * i0
  R = 0
  X = pop * x0
}

# Imitation dynamics for the mitigator count X = pop * x:
# dX/dt = kappa X (1 - X/pop) ( (I/pop)/eta0 e^{-lam t} - c )
ode {
  X = kappa * X * (1.0 - X / pop)
      * ((I / pop) * (1.0 / eta0) * exp(-lam * t) - c)
}

observations {
  cases {
    columns       { time : time, cases : count }
    projected     = incidence(infection)
    emit_schedule = every 1 'days
    cases         ~ normal(mean = projected / eta0, sd = sigma_i)
  }
  # Oxford stringency index / 100, matched to the mitigator proportion x
  # as in the paper; permille scale so camdl's discretized-count normal
  # loses < 0.1% to rounding.
  osi {
    columns       { time : time, osi : count }
    projected     = 1000.0 * X / pop
    emit_schedule = every 1 'days
    osi           ~ normal(mean = projected, sd = sigma_x)
  }
}

quantities {
  # paper's conventions: R0 without mitigation, Reff with mitigation "on"
  # (both at cos = 0; Table S3 medians are over the prediction window)
  R0_mean   = final(beta / gamma)
  x_final   = final(X / pop)
  peak_time = time_of_max(I)
}

simulate {
  from = 0 'days
  to   = 365 'days
}
